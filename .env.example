# Copy this file to .env. Both kamd and kam load it on every startup.
# They search from the current directory upward. Variables already present in
# the process environment take precedence over values in this file.

# Development configuration and data root.
# config.toml, accounts.json, daily.json, stats.json, logs, and the generated
# admin.sock are stored below this directory. Remove this variable to use the
# standard XDG configuration, data, and runtime locations.
KAM_HOME=.kam-dev

# Tracing filter. This value enables debug logs for the daemon and the main Kiro
# request/scheduling crates. Use "info" for quieter local output.
RUST_LOG=kamd=debug,kam_kiro=debug,kam_pool=debug

# Emit a Rust backtrace for panics and supported runtime errors.
# Use "full" instead of "1" for a more verbose backtrace.
RUST_BACKTRACE=1

# All variables below are optional. Uncomment only when needed.

# Override the business HTTP/HTTPS listening port for this kamd process.
# This takes precedence over server.port in config.toml until kamd is restarted
# without the variable. The default config.toml port is 5580.
# KAM_HTTP_PORT=5581

# Set exactly to 1 to disable the business HTTP/HTTPS plane.
# The Unix administration socket remains active, so kam CLI commands still work.
# KAM_DISABLE_HTTP=1

# Override the Unix socket used by the kam CLI.
# This variable does not change the socket on which kamd listens. To move the
# daemon socket, edit admin.socket in config.toml and restart kamd.
# KAM_ADMIN_SOCKET=.kam-dev/admin.sock

# Override the CodeWhisperer generation endpoint.
# Intended for integration tests or controlled upstream proxies. Production
# deployments should normally use the built-in endpoint.
# KAM_CODEWHISPERER_URL=https://codewhisperer.us-east-1.amazonaws.com/generateAssistantResponse

# Override the Amazon Q generation endpoint.
# Intended for integration tests or controlled upstream proxies. Production
# deployments should normally use the built-in endpoint.
# KAM_AMAZONQ_URL=https://q.us-east-1.amazonaws.com/generateAssistantResponse

# Docker entrypoint only: expose this container port through socat and forward
# it to 127.0.0.1:${KAM_HTTP_PORT:-5580}. The kamd and kam binaries do not read
# KAM_FORWARD_PORT directly.
# KAM_FORWARD_PORT=5580

# SSO/Chromium only: disable the Chromium sandbox.
# The runtime-full Docker image sets this because it already runs inside a
# container. Do not enable it for a normal host installation unless the security
# implications have been reviewed.
# KAM_CHROMIUM_NO_SANDBOX=1

# Optional editor used by `kam config edit`. VISUAL takes precedence over EDITOR.
# VISUAL="code --wait"
# EDITOR=vim
