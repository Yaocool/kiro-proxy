#!/bin/sh
set -eu

fail() {
  echo "kam: $*" >&2
  exit 1
}

command -v docker >/dev/null 2>&1 || fail "docker command not found"

if [ -n "${KAM_DOCKER_CONTAINER:-}" ]; then
  container_id="$KAM_DOCKER_CONTAINER"
else
  if [ -n "${KAM_COMPOSE_PROJECT:-}" ]; then
    containers="$(docker ps \
      --filter 'label=io.kiro-proxy.role=daemon' \
      --filter "label=com.docker.compose.project=${KAM_COMPOSE_PROJECT}" \
      --filter 'status=running' \
      --format '{{.ID}}')"
  else
    containers="$(docker ps \
      --filter 'label=io.kiro-proxy.role=daemon' \
      --filter 'status=running' \
      --format '{{.ID}}')"
  fi

  container_count="$(printf '%s\n' "$containers" | awk 'NF { count++ } END { print count + 0 }')"
  case "$container_count" in
    0)
      fail "no running kiro-proxy daemon container found"
      ;;
    1)
      container_id="$(printf '%s\n' "$containers" | awk 'NF { print; exit }')"
      ;;
    *)
      fail "multiple daemon containers found; set KAM_COMPOSE_PROJECT or KAM_DOCKER_CONTAINER"
      ;;
  esac
fi

if [ -t 0 ] && [ -t 1 ]; then
  exec docker exec -it "$container_id" /usr/local/bin/kam "$@"
else
  exec docker exec -i "$container_id" /usr/local/bin/kam "$@"
fi
