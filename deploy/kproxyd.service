[Unit]
Description=kiro-proxy daemon
Documentation=https://github.com/Yaocool/kiro-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kproxyd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
UMask=0077

User=kproxy
Group=kproxy

RuntimeDirectory=kproxy
RuntimeDirectoryMode=0750
StateDirectory=kproxy
StateDirectoryMode=0700
ConfigurationDirectory=kproxy
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_DATA_HOME=/var/lib

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/kproxy /var/lib/kproxy /run/kproxy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
# Chromium SSO uses a user-namespace sandbox and V8 JIT executable memory.
# Keep these capabilities available while the remaining unit hardening contains
# the unprivileged kproxy process.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
