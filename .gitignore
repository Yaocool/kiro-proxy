# Rust build artifacts and editor backups
/target/
**/*.rs.bk
*.pdb
.kam-dev/

# Local environment files (keep documented templates in version control)
.env
.env.*
!.env.example
!.env.*.example

# Local logs and OS metadata
*.log
.DS_Store
Thumbs.db

# IDE-local state. Project settings, tasks, and recommended extensions may be shared.
.idea/
.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/extensions.json

# AI-assisted development: local settings, indexes, caches, and session state.
# Keep shareable project instructions such as AGENTS.md and CLAUDE.md tracked.
.claude/*
.cursor/
.windsurf/
.continue/
.roo/
.codeium/
.aider*
.opencode/
.gemini/
.augment/
.codegraph/
.remember/
